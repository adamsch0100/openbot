# Copy to .env on the operator machine. Never commit .env.
# OpenBot does not need keys to boot Cos-only mode.

# OPENBOT_HOST=127.0.0.1
# OPENBOT_PORT=8787
# PORT is set by Railway; the board then listens on 0.0.0.0:$PORT.
# OPENBOT_WORK_DIR=/path/to/a/repo
# OPENBOT_SPEND_CAP_USD=5.00
# OPENBOT_SPEND_CAP_PERIOD=week
# OPENBOT_OPEN_BROWSER=1

# Engine auth lives with the engines, not in this file:
#   Hermes: official setup / Nous Portal
#   OpenCode: official auth

@@ -0,0 +1,196 @@
+import React from "react";
+import { Link } from "react-router-dom";
+import SEO from "../components/SEO";
+import QualifyCta from "../components/QualifyCta";
+import ChfaResourceHub from "../components/ChfaResourceHub";
+import {
+  CITATION_STATS,
+  CITATION_TOPICS,
+  HUB_CANONICAL,
+  HUB_REVIEWED,
+} from "../data/citationStats.js";
+
+const GOLD = "#CFB36E";
+const PAGE_TITLE =
+  "Colorado Housing Statistics & CHFA Citation Hub 2026 | SAA Homes";
+const PAGE_DESCRIPTION =
+  "Verified Colorado Housing and Finance Authority (CHFA) and Northern Colorado down payment statistics — each figure dated, sourced, and ready to cite. No outreach. Confirm overlays with a participating lender.";
+
+function datasetSchema() {
+  return {
+    "@context": "https://schema.org",
+    "@type": "Dataset",
+    name: "Colorado CHFA and Northern Colorado housing program statistics",
+    description: PAGE_DESCRIPTION,
+    url: HUB_CANONICAL,
+    dateModified: HUB_REVIEWED,
+    creator: {
+      "@type": "RealEstateAgent",
+      name: "Schwartz and Associates",
+      url: "https://saahomes.com",
+    },
+    license: "https://saahomes.com/housing-statistics/",
+    variableMeasured: CITATION_STATS.map((row) => row.claim),
+  };
+}
+
+function faqSchema() {
+  return {
+    "@context": "https://schema.org",
+    "@type": "FAQPage",
+    mainEntity: [
+      {
+        "@type": "Question",
+        name: "Can I cite these Colorado housing statistics?",
+        acceptedAnswer: {
+          "@type": "Answer",
+          text: "Yes. Each row names the first publisher, a source URL, an as-of window, and the date SAA Homes last retrieved it. Link to this page or to the original publisher. Program overlays still need a CHFA participating lender.",
+        },
+      },
+      {
+        "@type": "Question",
+        name: "Does SAA Homes originate these CHFA numbers?",
+        acceptedAnswer: {
+          "@type": "Answer",
+          text: "No. CHFA and the City of Greeley publish the figures. This hub traces each claim so writers and AI agents can cite a verified source without guessing.",
+        },
+      },
+    ],
+  };
+}
+
+export default function HousingStatisticsPage() {
+  return (
+    <>
+      <SEO
+        exactTitle={PAGE_TITLE}
+        description={PAGE_DESCRIPTION}
+        keywords="Colorado housing statistics, CHFA statistics, Northern Colorado housing data, CHFA down payment assistance numbers, cite CHFA"
+        canonical={HUB_CANONICAL}
+        ogTitle="Colorado CHFA & housing statistics you can cite"
+        ogDescription={PAGE_DESCRIPTION}
+        ogUrl={HUB_CANONICAL}
+        jsonLd={[datasetSchema(), faqSchema()]}
+      />
+
+      <section
+        className="relative min-h-[18rem] sm:h-96 bg-cover bg-center flex items-center justify-center pt-28 sm:pt-32 pb-8"
+        style={{ backgroundImage: "url('/images/core-image-8.jpg')" }}
+      >
+        <div className="absolute inset-0 bg-black/65" />
+        <div className="relative z-10 text-center text-white px-4 sm:px-6 max-w-4xl">
+          <p className="text-sm font-semibold uppercase tracking-widest mb-3" style={{ color: GOLD }}>
+            Citation hub · last verified {HUB_REVIEWED}
+          </p>
+          <h1 className="text-3xl sm:text-5xl font-bold font-serif">
+            Colorado housing statistics you can cite
+          </h1>
+          <p className="mt-4 text-lg sm:text-xl text-gray-100">
+            Every number names the organization that first published it. Writers and AI agents can link here instead of guessing.
+          </p>
+        </div>
+      </section>
+
+      <section className="py-12 px-6 bg-white">
+        <div className="max-w-4xl mx-auto text-gray-700 space-y-4 leading-relaxed">
+          <p>
+            Schwartz and Associates publishes this hub so a journalist, a CHFA explainer, or an AI agent can quote a{" "}
+            <strong>dated Colorado Housing and Finance Authority figure</strong> without emailing us. We do not buy links. We do not invent medians.
+          </p>
+          <p>
+            Rows stay on this page only when they pass the citation gate: first publisher, live URL, as-of window, retrieved date. If CHFA rotates a year-end highlight, the row updates or it comes off. Fair Housing still applies — these are program facts, not steering.
+          </p>
+          <p>
+            Need the program, not the footnote? Start with{" "}
+            <Link to="/chfa-down-payment-assistance/" className="underline font-semibold">
+              CHFA down payment assistance
+            </Link>
+            , the{" "}
+            <Link to="/glossary/" className="underline font-semibold">
+              CHFA glossary
+            </Link>
+            , or call{" "}
+            <a href="tel:+19709991407" className="underline font-semibold">(970) 999-1407</a>.
+          </p>
+        </div>
+      </section>
+
+      {CITATION_TOPICS.map((topic) => (
+        <section key={topic} className="py-10 px-6 border-t border-gray-100">
+          <div className="max-w-5xl mx-auto">
+            <h2 className="text-2xl sm:text-3xl font-bold font-serif mb-6">{topic}</h2>
+            <div className="grid gap-5">
+              {CITATION_STATS.filter((row) => row.topic === topic).map((row) => (
+                <article
+                  key={row.id}
+                  id={row.id}
+                  className="rounded-xl border border-gray-200 bg-gray-50 p-6 scroll-mt-28"
+                >
+                  <p className="text-4xl font-bold font-serif" style={{ color: "#1a1a1a" }}>
+                    {row.figure}
+                  </p>
+                  <p className="text-sm uppercase tracking-wide text-gray-500 mt-1">{row.unit}</p>
+                  <p className="mt-3 text-gray-800 leading-relaxed">{row.claim}</p>
+                  <dl className="mt-4 grid sm:grid-cols-2 gap-2 text-sm text-gray-600">
+                    <div>
+                      <dt className="font-semibold text-gray-800">First publisher</dt>
+                      <dd>{row.firstPublisher}</dd>
+                    </div>
+                    <div>
+                      <dt className="font-semibold text-gray-800">As of</dt>
+                      <dd>{row.asOf}</dd>
+                    </div>
+                    <div>
+                      <dt className="font-semibold text-gray-800">Retrieved</dt>
+                      <dd>{row.retrieved}</dd>
+                    </div>
+                    <div>
+                      <dt className="font-semibold text-gray-800">Source</dt>
+                      <dd>
+                        <a
+                          href={row.sourceUrl}
+                          className="underline"
+                          target={row.sourceUrl.startsWith("http") ? "_blank" : undefined}
+                          rel={row.sourceUrl.startsWith("http") ? "noopener noreferrer" : undefined}
+                        >
+                          {row.sourceLabel}
+                        </a>
+                      </dd>
+                    </div>
+                  </dl>
+                  <p className="mt-3 text-xs text-gray-500">
+                    Suggested citation: {row.cite} Permalink:{" "}
+                    <a href={`#${row.id}`} className="underline">
+                      saahomes.com/housing-statistics/#{row.id}
+                    </a>
+                  </p>
+                </article>
+              ))}
+            </div>
+          </div>
+        </section>
+      ))}
+
+      <section className="py-12 px-6 bg-gray-100">
+        <div className="max-w-4xl mx-auto text-sm text-gray-600 space-y-3">
+          <h2 className="text-xl font-bold font-serif text-gray-900">How to cite · equal housing</h2>
+          <p>
+            Prefer the original publisher when you can (CHFA.org, the City of Greeley). Use this page when you need a single URL that already traced the claim. Do not treat SAA Homes as the author of a CHFA production number.
+          </p>
+          <p>
+            We do business in accordance with the Fair Housing Act. Program eligibility is about income, credit, occupancy, and published program rules — never protected class.
+          </p>
+        </div>
+      </section>
+
+      <QualifyCta
+        program="CHFA down payment assistance"
+        formAnchor="/chfa-down-payment-assistance/#chfa-dpa-lead-form"
+        formLabel="CHFA eligibility form"
+        headline="Want the program behind the numbers?"
+        subtext="Adam and Mandi help Northern Colorado buyers match CHFA, G-HOPE, and city programs to a home that actually qualifies."
+      />
+      <ChfaResourceHub />
+    </>
+  );
+}
-- 

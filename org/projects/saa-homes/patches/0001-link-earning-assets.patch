+export function getGlossaryTerm(slug) {
+  const key = String(slug || '').replace(/\/$/, '');
+  return GLOSSARY_TERMS.find((row) => row.slug === key) || null;
+}
+
+export function glossaryGrouped() {
+  const groups = new Map();
+  for (const row of GLOSSARY_TERMS) {
+    const letter = row.term.charAt(0).toUpperCase();
+    if (!groups.has(letter)) groups.set(letter, []);
+    groups.get(letter).push(row);
+  }
+  return [...groups.entries()].sort(([a], [b]) => a.localeCompare(b));
+}
+
+function wordCount(text) {
+  return String(text || '').trim().split(/\s+/).filter(Boolean).length;
+}
+
+export function assertGlossaryDefinitions() {
+  return GLOSSARY_TERMS.filter((row) => wordCount(row.definition) > 50).map((row) => row.slug);

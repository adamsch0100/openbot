+import React from "react";
+import { Link, Navigate, useParams } from "react-router-dom";
+import SEO from "../components/SEO";
+import QualifyCta from "../components/QualifyCta";
+import {
+  GLOSSARY_BYLINE,
+  GLOSSARY_REVIEWED,
+  getGlossaryTerm,
+} from "../data/glossaryTerms.js";
+
+const GOLD = "#CFB36E";
+
+export default function GlossaryTermPage() {
+  const { slug } = useParams();
+  const term = getGlossaryTerm(slug);
+  if (!term) {
+    return <Navigate to="/glossary/" replace />;
+  }
+
+  const canonical = `https://saahomes.com/glossary/${term.slug}/`;
+  const title = `${term.h1} | SAA Homes`;
+
+  return (
+    <>
+      <SEO
+        exactTitle={title}
+        description={term.definition}
+        canonical={canonical}
+        ogTitle={term.h1}
+        ogDescription={term.definition}
+        ogUrl={canonical}
+        jsonLd={[
+          {
+            "@context": "https://schema.org",
+            "@type": "DefinedTerm",
+            name: term.term,
+            description: term.definition,
+            url: canonical,
+            inDefinedTermSet: "https://saahomes.com/glossary/",
+          },
+        ]}
+      />
+
+      <article className="pt-28 sm:pt-32 pb-8">
+        <header className="px-6 pb-10 bg-black text-white">
+          <div className="max-w-3xl mx-auto">
+            <p className="text-sm font-semibold uppercase tracking-widest mb-3" style={{ color: GOLD }}>
+              <Link to="/glossary/" className="hover:underline">
+                Glossary
+              </Link>
+            </p>
+            <h1 className="text-3xl sm:text-5xl font-bold font-serif">{term.h1}</h1>
+            <p className="mt-6 text-lg sm:text-xl leading-relaxed text-gray-100">{term.definition}</p>
+          </div>
+        </header>
+
+        <div className="max-w-3xl mx-auto px-6 py-12 space-y-8 text-gray-700 leading-relaxed">
+          <p>
+            In Northern Colorado (Larimer, Weld, and Boulder counties) this term usually shows up when a buyer is choosing a first mortgage, stacking down payment help, or checking whether a listing sits inside program caps. Schwartz and Associates coordinates the home search; a{" "}
+            <Link to="/glossary/chfa-participating-lender/" className="underline font-semibold">
+              CHFA participating lender
+            </Link>{" "}
+            underwrites the loan.
+          </p>
+          <p>
+            Next step: read{" "}
+            <Link to={term.moneyPath} className="underline font-semibold">
+              {term.moneyLabel}
+            </Link>{" "}
+            or call <a href="tel:+19709991407" className="underline font-semibold">(970) 999-1407</a>.
+          </p>
+
+          {term.related.length > 0 && (
+            <section>
+              <h2 className="text-2xl font-bold font-serif text-gray-900 mb-3">Related terms</h2>
+              <ul className="list-disc pl-5 space-y-1">
+                {term.related.map((rel) => (
+                  <li key={rel}>
+                    <Link to={`/glossary/${rel}/`} className="underline">
+                      {rel.replace(/-/g, " ")}
+                    </Link>
+                  </li>
+                ))}
+              </ul>
+            </section>
+          )}
+
+          <section className="text-sm text-gray-600 border-t border-gray-200 pt-6 space-y-2">
+            <p>
+              <strong>Byline:</strong> {GLOSSARY_BYLINE}
+            </p>
+            <p>
+              <strong>Last reviewed:</strong> {GLOSSARY_REVIEWED}
+            </p>
+            <p>
+              <strong>Sources:</strong>{" "}
+              {term.sources.map((src, i) => (
+                <span key={src.href}>
+                  {i > 0 ? " · " : ""}
+                  <a
+                    href={src.href}
+                    className="underline"
+                    target={src.href.startsWith("http") ? "_blank" : undefined}
+                    rel={src.href.startsWith("http") ? "noopener noreferrer" : undefined}
+                  >
+                    {src.label}
+                  </a>
+                </span>
+              ))}
+            </p>
+            <p>
+              Equal housing opportunity. Program rules change — confirm with the first publisher and a participating lender before you write an offer.
+            </p>
+          </section>
+        </div>
+      </article>
+
+      <QualifyCta
+        program={term.term}
+        formAnchor={`${term.moneyPath.replace(/\/$/, "")}/#chfa-dpa-lead-form`}
+        formLabel="Talk to SAA Homes"
+      />
+    </>
+  );
+}
